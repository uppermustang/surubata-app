generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String
  createdAt DateTime @default(now())
}

model AudienceRequest {
  id        String   @id @default(cuid())
  kind      String
  name      String?
  email     String?
  message   String
  locale    String
  createdAt DateTime @default(now())
}
